# Copie ce fichier en .env.local et remplis tes propres valeurs.
# .env.local ne doit JAMAIS être commit (déjà ignoré par défaut par Vite/git).

# --- Supabase (frontend) ---
# Trouvables dans Supabase > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Secrets côté serveur (Edge Functions uniquement, PAS dans le frontend) ---
# À définir avec : supabase secrets set NOM=valeur
# GEMINI_API_KEY=...                     (Google AI Studio)
# GOOGLE_SERVICE_ACCOUNT_JSON=...        (JSON complet du compte de service Google Cloud)
# GOOGLE_DRIVE_FOLDER_ID=...             (ID du dossier Drive contenant les cours)
